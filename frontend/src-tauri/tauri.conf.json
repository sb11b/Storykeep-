{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "StoryKeep",
  "version": "0.1.0",
  "identifier": "com.storykeep.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npx cross-env NEXT_OUTPUT=export NEXT_PUBLIC_API_ORIGIN=https://storykeep-production.up.railway.app npm run build",
    "devUrl": "http://localhost:43123",
    "frontendDist": "../out"
  },
  "app": {
    "windows": [
      {
        "title": "StoryKeep",
        "width": 1280,
        "height": 860,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
