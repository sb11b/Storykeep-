+def sentence_summary(excerpt: str, sentences: int = 4) -> str:
+    text = " ".join((excerpt or "").split())
+    if not text:
+        return ""
+    parts = [part.strip() for part in re.split(r"(?<=[.!?])\s+", text) if part.strip()]
