# Local
DATABASE_URL=postgresql+psycopg2://storykeep:storykeep@127.0.0.1:5432/storykeep
# Railway Postgres is also accepted as postgresql:// or postgres://
SECRET_KEY=change-me-in-production-storykeep
SEED_DEMO=1
S3_BUCKET=
AWS_REGION=us-east-1
# Backblaze B2 (S3-compatible). Railway uses these names.
B2_KEY_ID=
B2_APPLICATION_KEY=
B2_BUCKET=
B2_ENDPOINT=
B2_REGION=
BACKUP_INTERVAL_HOURS=24
CORS_ORIGINS=http://127.0.0.1:43123,http://localhost:43123
FRONTEND_DIR=
# Local default is backend/var. Production: /app/var on the storykeep volume.
DATA_DIR=
# Junior reply budget (~100k words). Legacy 2048 pins are ignored automatically.
XAI_CHAT_MAX_TOKENS=125000
# Junior Railway + GitHub (owner-only, server-side).
RAILWAY_API_TOKEN=
RAILWAY_PROJECT_ID=
RAILWAY_SERVICE_ID=
RAILWAY_ENVIRONMENT_ID=
RAILWAY_PUBLIC_DOMAIN=
GITHUB_TOKEN=
GITHUB_REPO=sb11b/Storykeep-
